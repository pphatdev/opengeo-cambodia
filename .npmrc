# ========================================================
# OpenGeo Cambodia - Package Manager Supply Chain Hardening
# ========================================================

# 1. Store Directory
store-dir=./.pnpm-store

# 2. Prevent Malicious Lifecycle Scripts (Pre/Postinstall)
# Blocks arbitrary RCE during package installation
ignore-scripts=true

# 3. Cryptographic Checksum Verification
# Validates package integrity against hash digests before extraction
verify-store-integrity=true

# 4. Strict Lockfile & Reproducible Builds
# Ensures no silent or unreviewed changes to pnpm-lock.yaml
prefer-frozen-lockfile=true

# 5. Exact Version Pinning
# Ensures all newly installed packages are pinned to exact versions (no ^ or ~)
save-exact=true

# 6. Strict Peer Dependencies & Registry Lockdown
# Prevents dependency confusion and phantom dependency attacks
strict-peer-dependencies=true
auto-install-peers=true
registry=https://registry.npmjs.org/

# 7. Security Auditing Threshold
# Fails or warns on high/critical known vulnerabilities
audit-level=high

{
    "name": "opengeo-cambodia-api",
    "version": "1.9.0",
    "description": "An Open API for Cambodia geography data providing complete 4-tier administrative hierarchy (Provinces, Districts, Communes, Villages), 100% free to use, with sub-1ms response times",
    "homepage": "https://opengeo-cambodia.pphat.me",
    "main": "dist/index.js",
    "type": "module",
    "packageManager": "pnpm@10.5.2",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:api": "tsx watch src/index.ts",
        "dev:web": "vite web",
        "build": "tsc && node dist/scripts/copy-assets.js",
        "postbuild": "node dist/scripts/generate-llms.js && node dist/scripts/generate-sitemap.js && vite build web",
        "build:web": "vite build web",
        "preview:web": "vite preview web",
        "generate:llms": "tsx src/scripts/generate-llms.ts",
        "generate:sitemap": "tsx src/scripts/generate-sitemap.ts",
        "start": "node dist/index.js",
        "sync:overpass": "tsx src/scripts/sync-overpass.ts",
        "convert:csv": "tsx src/scripts/convert-csv.ts",
        "update:provinces": "tsx src/scripts/update-provinces.ts",
        "update:districts": "tsx src/scripts/update-districts.ts",
        "update:communes": "tsx src/scripts/update-communes.ts",
        "update:villages": "tsx src/scripts/update-villages.ts",
        "update:all": "tsx src/scripts/update-provinces.ts && tsx src/scripts/update-districts.ts && tsx src/scripts/update-communes.ts && tsx src/scripts/update-villages.ts",
        "lint": "tsc --noEmit && tsc -p tsconfig.worker.json && tsc -p web/tsconfig.json",
        "audit:security": "pnpm audit --audit-level=high",
        "verify:lockfile": "pnpm install --frozen-lockfile",
        "security:check": "pnpm audit --audit-level=high && tsc --noEmit",
        "predeploy": "tsx src/scripts/copy-assets.ts && tsx src/scripts/generate-sitemap.ts && vite build web",
        "deploy": "wrangler deploy",
        "preview": "vite build web && wrangler dev",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "keywords": [
        "cambodia",
        "geocoding",
        "osm",
        "openstreetmap",
        "hono",
        "honojs",
        "nominatim",
        "overpass",
        "administrative-boundaries",
        "provinces",
        "districts",
        "communes",
        "villages"
    ],
    "author": "Sophat",
    "license": "MIT",
    "dependencies": {
        "@hono/node-server": "2.1.6",
        "@hono/zod-validator": "0.9.1",
        "axios": "1.21.0",
        "dotenv": "18.0.9",
        "hono": "4.13.17",
        "marked": "18.1.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.5",
        "@types/geojson": "7946.0.16",
        "@types/leaflet": "1.9.22",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "leaflet": "1.9.4",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-leaflet": "5.0.0",
        "react-router": "8.5.1",
        "tailwindcss": "4.3.5",
        "tsx": "^4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "wrangler": "^4.157.0"
    }
}
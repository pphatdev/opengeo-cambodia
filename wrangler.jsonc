{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opengeo-cambodia-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  // Per-deploy version id: namespaces the edge cache so old responses are never served after a deploy
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    {
      "pattern": "opengeo-cambodia.pphat.me",
      "custom_domain": true,
      "zone_name": "pphat.me"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "APP_DOMAIN": "opengeo-cambodia.pphat.me",
    "APP_URL": "https://opengeo-cambodia.pphat.me",
    "NOMINATIM_BASE_URL": "https://nominatim.openstreetmap.org",
    "NOMINATIM_USER_AGENT": "OpenGeoCambodia/1.0 (contact@opengeo-cambodia.pphat.me)",
    "OVERPASS_API_URL": "https://overpass-api.de/api/interpreter",
    "CACHE_TTL_SECONDS": "31536000",
    "MISTRAL_MODEL": "mistral-small-2603"
  },
  "previews": {
    "vars": {
      "NODE_ENV": "production",
      "APP_DOMAIN": "develop-opengeo-cambodia-api.pphatdev.workers.dev",
      "APP_URL": "https://develop-opengeo-cambodia-api.pphatdev.workers.dev",
      "NOMINATIM_BASE_URL": "https://nominatim.openstreetmap.org",
      "NOMINATIM_USER_AGENT": "OpenGeoCambodia/1.0 (contact@opengeo-cambodia.pphat.me)",
      "OVERPASS_API_URL": "https://overpass-api.de/api/interpreter",
      "CACHE_TTL_SECONDS": "31536000",
      "MISTRAL_MODEL": "mistral-small-2603"
    }
  },
  "observability": {
    "enabled": true
  }
}